# Fabric search (app/api/fabrics). The six Shopify fabric shops need no keys.
# Secondhand sources switch on when their keys are set; without them they are skipped.

# eBay Buy › Browse API, production keyset from developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Which eBay site to search (EBAY_GB, EBAY_DE, …). Default EBAY_GB.
EBAY_MARKETPLACE=EBAY_GB
# eBay Partner Network campaign id, so referred purchases earn commission
EBAY_CAMPAIGN_ID=

# Etsy Open API v3: "keystring" or "keystring:shared_secret"
ETSY_API_KEY=
