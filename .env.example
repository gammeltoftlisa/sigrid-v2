# Fabric search (app/api/fabrics). The six Shopify fabric shops need no keys.
# Secondhand sources switch on when their keys are set; without them they are skipped.

# eBay Buy › Browse API, production keyset from developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Which eBay site to search (EBAY_GB, EBAY_DE, …). Default EBAY_GB.
EBAY_MARKETPLACE=EBAY_GB
# eBay Partner Network campaign id, so referred purchases earn commission
EBAY_CAMPAIGN_ID=

# Etsy Open API v3: "keystring" or "keystring:shared_secret"
ETSY_API_KEY=

# Login (Clerk) and payments (Stripe): set by the Vercel Marketplace integrations, get them with "vercel env pull".
# CLERK_SECRET_KEY, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, STRIPE_SECRET_KEY

# Charge for patterns. Leave off during the beta (lib/payments.ts).
NEXT_PUBLIC_PAYMENTS_ENABLED=

# Payments. Neon's DATABASE_URL arrives through the Vercel Marketplace; create the tables with npm run db:migrate (uses .env.development.local)
DATABASE_URL=
# Signing secret of the Stripe webhook endpoint for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
